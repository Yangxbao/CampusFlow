# ===== CampusFlow 环境变量样例（复制为 .env 使用，勿提交真实密码） =====

# MySQL（docker-compose 容器初始化 root 密码）
MYSQL_ROOT_PASSWORD=campusflow123
# 业务账号密码（后端连接 MySQL 使用）
MYSQL_PASSWORD=campusflow123
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=123321
REDIS_PORT=6379

# RocketMQ（compose 内部网络固定名）
# ROCKETMQ_NAMESERVER=rocketmq-namesrv:9876

# JWT 签名密钥（生产必须替换，>= 32 字节）
JWT_SECRET=please-change-me-to-a-random-32-bytes-secret!!

# 应用端口
BACKEND_PORT=8080
FRONTEND_PORT=80

# 本地开发（非 Docker，连接 VMware 虚拟机中间件时）
# MYSQL_HOST=127.0.0.1
# MYSQL_USERNAME=root
# REDIS_HOST=192.168.100.128
# ROCKETMQ_NAMESERVER=192.168.100.128:9876
# CAMPUSFLOW_WORKER_ID=1
